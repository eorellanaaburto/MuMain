+    private async ValueTask SendAdnielStatusAsync()
+    {
+        var connection = this._player.Connection;
+        if (connection is null)
+        {
+            return;
+        }
+
+        var pentagram = this._player.PentagramStorage?.EquippedPentagram;
+        var equipped = pentagram is not null;
+        byte pentagramLevel = 0;
+        var ranks = new byte[MUnique.OpenMU.GameLogic.ErrtelHelper.ErrtelCount];
+        var levels = new byte[MUnique.OpenMU.GameLogic.ErrtelHelper.ErrtelCount];
+        var options = new byte[MUnique.OpenMU.GameLogic.ErrtelHelper.ErrtelCount];
+
+        if (pentagram is not null)
+        {
+            pentagramLevel = (byte)Math.Clamp((int)pentagram.Level, 0, 15);
+            for (var socket = 0; socket < MUnique.OpenMU.GameLogic.ErrtelHelper.ErrtelCount; socket++)
+            {
+                var links = MUnique.OpenMU.GameLogic.ErrtelHelper.GetErrtelOptions(pentagram, socket);
+                if (links.Count == 0)
+                {
+                    continue;
+                }
+
+                var rank = links.Select(l => (int)(l.ItemOption?.SubOptionType ?? 1)).DefaultIfEmpty(1).Max();
+                var level = links.Where(l => (int)(l.ItemOption?.SubOptionType ?? 1) == rank).Select(l => (int)l.Level).DefaultIfEmpty(0).Max();

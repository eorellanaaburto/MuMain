+            var span = connection.Output.GetSpan(packetLength)[..packetLength];
+            span.Clear();
+            span[0] = 0xC3;
+            span[1] = packetLength;
+            span[2] = 0x30;
+            span[3] = 0x2A;
+            span[4] = equipped ? (byte)1 : (byte)0;
+            span[5] = pentagramLevel;
+            for (var i = 0; i < MUnique.OpenMU.GameLogic.ErrtelHelper.ErrtelCount; i++)
+            {
+                span[6 + i] = ranks[i];
+                span[11 + i] = levels[i];
+                span[16 + i] = options[i];
+            }
+
+            return packetLength;
+        }
+
+        await connection.SendAsync(Write).ConfigureAwait(false);

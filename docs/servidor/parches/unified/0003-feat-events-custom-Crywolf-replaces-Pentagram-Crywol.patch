-    private static async ValueTask GiveBoxOfKundunAsync(Player player, IGameContext ctx, int level)
-    {
-        // Box of Luck family: Group=14, Number=11. Level 8=BoK+1 \u2026 12=BoK+5.
-        var bokDef = ctx.Configuration.Items.FirstOrDefault(i => i.Group == 14 && i.Number == 11);
-        if (bokDef is null) return;
-
-        byte itemLevel = (byte)Math.Min(level, bokDef.MaximumItemLevel);
-        for (int i = 0; i < 10; i++)
-        {
-            var item = new TemporaryItem { Definition = bokDef, Level = itemLevel, Durability = 1 };
-            await DeliverItemAsync(player, item).ConfigureAwait(false);
-        }
-    }

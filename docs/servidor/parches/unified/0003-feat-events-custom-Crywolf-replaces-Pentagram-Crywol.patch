+            {
+                await Task.Delay(500, token).ConfigureAwait(false);
+                await state.SnapContractedElfsAsync().ConfigureAwait(false);
+            }
+            catch (OperationCanceledException) { break; }
+            catch { /* absorb */ }
+        }
+    }
+
+    private static async Task MonitorContractsAsync(CrywolfGameServerState state, CancellationToken token)
+    {
+        var ctx = state.Context;
+        int tick = 0;
+        while (!token.IsCancellationRequested)
+        {
+            try
+            {
+                await Task.Delay(MonitorInterval, token).ConfigureAwait(false);
+                state.CheckAndBreakMovedContracts();
+
+                tick++; // tick kept for future use
+            }
+            catch (OperationCanceledException) { break; }
+            catch { /* absorb */ }
+        }
+    }
+
+    /// <inheritdoc />
+    protected override async ValueTask OnFinishedAsync(InvasionGameServerState state)
+    {
+        // If base timer fires while Balgass is still alive, let the boss-killed watcher
+        // call this method once the boss dies (watcher uses absolute deadline, not IsCrywolfRunning).
+        if (state is CrywolfGameServerState cs0 && cs0.BossSpawned && !cs0.BossKilled && !cs0.CrywolfFailed)
+            return;
+
+        // Guard against double-execution (boss-killed watcher + defeat watcher both call this).
+        if (Interlocked.Exchange(ref this._onFinishedGuard, 1) != 0) return;
+
+        if (state is not CrywolfGameServerState crywolfState)
+        {
+            await base.OnFinishedAsync(state).ConfigureAwait(false);
+            return;
+        }
+
+        var ctx    = state.Context;
+        var logger = ctx.LoggerFactory.CreateLogger(this.GetType());
+
+        if (crywolfState.EventCts is { } cts)
+            await cts.CancelAsync().ConfigureAwait(false);
+        CrywolfContractRegistry.Unregister(ctx);
+
+        bool armyOk       = crywolfState.ArmySpawnSucceeded;
+        bool bossDefeated = crywolfState.BossSpawned && crywolfState.BossKilled;
+        bool victory      = armyOk && bossDefeated; // Matar a Balgass = victoria
+
+        logger.LogInformation(
+            "[Crywolf] RESULTADO: Army={A} BossSpawned={BS} BossKilled={BK} Victoria={V}",
+            armyOk, crywolfState.BossSpawned, crywolfState.BossKilled, victory);
+
+        crywolfState.RecordActiveContracts();
+        await AwardParticipantsAsync(crywolfState, ctx, victory).ConfigureAwait(false);
+
+        // Remove surviving invaders â€” they must not linger after the event ends.
+        var eventMap = crywolfState.CrywolfMap;
+        if (eventMap is not null)
+        {
+            foreach (var invader in crywolfState.GetAndClearInvaders())
+            {
+                try { await eventMap.RemoveAsync(invader).ConfigureAwait(false); }
+                catch { /* ignore individual failures */ }
+            }
+            if (crywolfState.BossMonster is { IsAlive: true } boss)
+            {
+                try { await eventMap.RemoveAsync(boss).ConfigureAwait(false); }
+                catch { /* ignore */ }
+            }
+        }
+
+        var map = crywolfState.CrywolfMap;
+        if (map is not null && crywolfState.FlippedTiles.Count > 0)
+        {
+            var t = map.Terrain;
+            // Compute the bounding box of only the tiles that were originally safezone (sanctuary area).
+            // This avoids telling clients the full map is safezone â€” only the temple is restored.
+            byte minX = 255, minY = 255, maxX = 0, maxY = 0;
+            foreach (var (x, y) in crywolfState.FlippedTiles)
+            {
+                t.SafezoneMap[x, y] = true;
+                t.UpdateAiGridValue(x, y);
+                if (x < minX) minX = x;
+                if (y < minY) minY = y;
+                if (x > maxX) maxX = x;
+                if (y > maxY) maxY = y;
+            }
+            crywolfState.FlippedTiles.Clear();
+
+            // Restore only the sanctuary bounding box on the client side â€” outer areas stay non-safezone.
+            await ctx.ForEachPlayerAsync(p =>
+            {
+                if (!ReferenceEquals(p.CurrentMap, map)) return Task.CompletedTask;
+                return p.InvokeViewPlugInAsync<IChangeTerrainAttributesViewPlugin>(v =>
+                    v.ChangeAttributesAsync(TerrainAttributeType.Safezone, true, [(minX, minY, maxX, maxY)])).AsTask();
+            }).ConfigureAwait(false);
+        }
+
+        crywolfState.CrywolfFailed = !victory;
+        crywolfState.CrywolfMap    = null;
+
+        string defeatReason = !armyOk
+            ? "El ejÃ©rcito invasor no pudo desplegarse."
+            : crywolfState.CrywolfFailed && !crywolfState.WolfStatueAlive
+                ? "Â¡La Wolf Statue fue destruida!"
+                : crywolfState.AltarsAlive <= 0
+                    ? "Todos los Wolf Altars fueron destruidos."
+                    : "Balgass no fue derrotado a tiempo.";
+
+        string globalMsg = victory
+            ? "â˜… [Crywolf] Â¡VICTORIA! La Wolf Statue resistiÃ³. Â¡HÃ©roes de Crywolf recompensados con EXP! â˜…"
+            : $"[Crywolf] DERROTA. {defeatReason} Sin recompensas.";
+
+        await ctx.SendGlobalNotificationAsync(globalMsg).ConfigureAwait(false);
+
+        crywolfState.IsCrywolfRunning = false;
+
+        await base.OnFinishedAsync(state).ConfigureAwait(false);
+    }
+
+    private static async Task AwardParticipantsAsync(CrywolfGameServerState state, IGameContext ctx, bool victory)
+    {
+        var crywolfMap = state.CrywolfMap;
+        var elfBonuses = new HashSet<Player>(state.GetElfContractBonuses());
+
+        // Collect participants and compute SHARED rank from total team kill points.
+        var participants = new List<Player>();
+        int totalPts = 0;
+        await ctx.ForEachPlayerAsync(player =>
+        {
+            if (crywolfMap is not null && !ReferenceEquals(player.CurrentMap, crywolfMap)) return Task.CompletedTask;
+            participants.Add(player);
+            totalPts += state.GetPlayerPoints(player) + (elfBonuses.Contains(player) ? PtElfContract : 0);
+            return Task.CompletedTask;
+        }).ConfigureAwait(false);
+
+        int rankIdx = totalPts switch
+        {
+            <= 1_000  => 0, // D
+            <= 3_000  => 1, // C
+            <= 5_000  => 2, // B
+            <= 10_000 => 3, // A
+            _         => 4  // S
+        };
+        string rank = rankIdx switch { 0 => "D", 1 => "C", 2 => "B", 3 => "A", _ => "S" };
+
+        int exp = victory ? rankIdx switch
+        {
+            0 => 50_000,
+            1 => 250_000,
+            2 => 600_000,
+            3 => 1_000_000,
+            _ => 1_800_000
+        } : 0;
+
+        // Award every participant the same rank.
+        foreach (var player in participants)
+        {
+            var character = player.SelectedCharacter;
+            if (victory && exp > 0 && character is not null)
+                character.Experience += exp;
+
+            await player.ShowBlueMessageAsync(
+                $"[Crywolf] Rank {rank} â€” {totalPts:N0} pts totales"
+                + (exp > 0 ? $" | +{exp:N0} EXP" : string.Empty)).ConfigureAwait(false);
+
+            if (!victory) continue;
+
+            // 10Ã— Caja de Kundun +5
+            await GiveBoxOfKundunAsync(player, ctx, 12).ConfigureAwait(false);
+
+            // 1 item excelente FULL nivel mÃ¡ximo: arma O armadura, aleatorio para la clase
+            await GiveExcellentItemAsync(player, ctx).ConfigureAwait(false);
+        }
+    }
+
+    private static async ValueTask GiveBoxOfKundunAsync(Player player, IGameContext ctx, int level)
+    {
+        // Box of Luck family: Group=14, Number=11. Level 8=BoK+1 â€¦ 12=BoK+5.
+        var bokDef = ctx.Configuration.Items.FirstOrDefault(i => i.Group == 14 && i.Number == 11);
+        if (bokDef is null) return;
+
+        byte itemLevel = (byte)Math.Min(level, bokDef.MaximumItemLevel);
+        for (int i = 0; i < 10; i++)
+        {
+            var item = new TemporaryItem { Definition = bokDef, Level = itemLevel, Durability = 1 };
+            await DeliverItemAsync(player, item).ConfigureAwait(false);
+        }
+    }
+
+    private static async ValueTask GiveExcellentItemAsync(Player player, IGameContext ctx)
+    {
+        var charClass = player.SelectedCharacter?.CharacterClass;
+        if (charClass is null) return;
+
+        // Groups 0-5: weapons. Groups 6-11: armor (helm/armor/pants/gloves/boots/shield).
+        // Excludes ammunition and items without excellent options.
+        var eligible = ctx.Configuration.Items
+            .Where(i => i.Group <= 11
+                        && !i.IsAmmunition
+                        && i.QualifiedCharacters.Contains(charClass)
+                        && i.PossibleItemOptions.Any(o =>
+                               o.PossibleOptions.Any(p => p.OptionType == ItemOptionTypes.Excellent)))
+            .ToList();
+
+        if (eligible.Count == 0) return;
+
+        var itemDef   = eligible[Random.Shared.Next(eligible.Count)];
+        byte itemLevel = (byte)Math.Min(15, (int)itemDef.MaximumItemLevel);
+
+        var item = new TemporaryItem
+        {
+            Definition = itemDef,
+            Level      = itemLevel,
+            HasSkill   = itemDef.Skill is not null,
+            Durability = itemDef.Durability,
+        };
+
+        // All excellent options
+        foreach (var opt in itemDef.PossibleItemOptions
+                     .SelectMany(o => o.PossibleOptions)
+                     .Where(p => p.OptionType == ItemOptionTypes.Excellent))
+            item.ItemOptions.Add(new ItemOptionLink { ItemOption = opt });
+
+        // Luck
+        var luckOpt = itemDef.PossibleItemOptions
+            .SelectMany(o => o.PossibleOptions)
+            .FirstOrDefault(p => p.OptionType == ItemOptionTypes.Luck);
+        if (luckOpt is not null)
+            item.ItemOptions.Add(new ItemOptionLink { ItemOption = luckOpt });
+
+        await DeliverItemAsync(player, item).ConfigureAwait(false);
+        string tipo = itemDef.Group <= 5 ? "arma" : "armadura";
+        await player.ShowBlueMessageAsync($"[Crywolf] Â¡Premio! {tipo} excelente FULL nivel mÃ¡ximo entregada.").ConfigureAwait(false);
+    }
+
+    private static async ValueTask DeliverItemAsync(Player player, Item item)
+    {
+        // CollectionAdapter (EF-backed) requires EntityFramework.Model.Item â€” TemporaryItem must be
+        // converted to a persistent entity before touching the inventory storage.
+        var persistentItem = item is TemporaryItem tmp
+            ? tmp.MakePersistent(player.PersistenceContext)
+            : item;
+
+        if (player.Inventory is not null && await player.Inventory.AddItemAsync(persistentItem).ConfigureAwait(false))
+        {
+            await player.InvokeViewPlugInAsync<IItemAppearPlugIn>(p => p.ItemAppearAsync(persistentItem)).ConfigureAwait(false);
+        }
+        else
+        {
+            var map = player.CurrentMap;
+            if (map is null) return;
+            var pos = map.Terrain.GetRandomCoordinate(player.Position, 2);
+            await map.AddAsync(new DroppedItem(persistentItem, pos, map, player)).ConfigureAwait(false);
+        }
+    }
+}

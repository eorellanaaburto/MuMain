-    private static async Task AwardParticipantsAsync(CrywolfGameServerState state, IGameContext ctx, bool victory)
-    {
-        var crywolfMap = state.CrywolfMap;
-        var elfBonuses = new HashSet<Player>(state.GetElfContractBonuses());
-
-        // Collect participants and compute SHARED rank from total team kill points.
-        var participants = new List<Player>();
-        int totalPts = 0;
-        await ctx.ForEachPlayerAsync(player =>
-        {
-            if (crywolfMap is not null && !ReferenceEquals(player.CurrentMap, crywolfMap)) return Task.CompletedTask;
-            participants.Add(player);
-            totalPts += state.GetPlayerPoints(player) + (elfBonuses.Contains(player) ? PtElfContract : 0);
-            return Task.CompletedTask;
-        }).ConfigureAwait(false);
-
-        int rankIdx = totalPts switch
-        {
-            <= 1_000  => 0, // D
-            <= 3_000  => 1, // C
-            <= 5_000  => 2, // B
-            <= 10_000 => 3, // A
-            _         => 4  // S
-        };
-        string rank = rankIdx switch { 0 => "D", 1 => "C", 2 => "B", 3 => "A", _ => "S" };
-
-        int exp = victory ? rankIdx switch
-        {
-            0 => 50_000,
-            1 => 250_000,
-            2 => 600_000,
-            3 => 1_000_000,
-            _ => 1_800_000
-        } : 0;
-
-        // Award every participant the same rank.
-        foreach (var player in participants)
-        {
-            var character = player.SelectedCharacter;
-            if (victory && exp > 0 && character is not null)
-                character.Experience += exp;
-
-            await player.ShowBlueMessageAsync(
-                $"[Crywolf] Rank {rank} \u2014 {totalPts:N0} pts totales"
-                + (exp > 0 ? $" | +{exp:N0} EXP" : string.Empty)).ConfigureAwait(false);
-
-            if (!victory) continue;
-
-            // 10\u00d7 Caja de Kundun +5
-            await GiveBoxOfKundunAsync(player, ctx, 12).ConfigureAwait(false);
-
-            // 1 item excelente FULL nivel m\u00e1ximo: arma O armadura, aleatorio para la clase
-            await GiveExcellentItemAsync(player, ctx).ConfigureAwait(false);
-        }
-
-        if (victory && participants.Count > 0)
-        {
-            var names = participants
-                .Select(p => p.SelectedCharacter?.Name)
-                .Where(n => n is not null)
-                .Select(n => n!)
-                .ToList();
-            await ActivateShadowBonusAsync(ctx, names).ConfigureAwait(false);
-        }
-    }

+    // â”€â”€ Proximity-based contract creation (prep phase) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
+    // Elf players within ActivationRange tiles of any altar auto-receive a contract.
+    // This replaces the attack-based activation (which requires terrain notification to work).
+    private const int ElfActivationRange = 5;
+    private static readonly HashSet<int> ElfClassNumbers = [8, 10, 11];
+
+    private static async Task PrepPhaseElfProximityAsync(
+        CrywolfGameServerState state, IGameContext ctx, CancellationToken token)
+    {
+        while (!token.IsCancellationRequested)
+        {
+            try
+            {
+                await Task.Delay(2000, token).ConfigureAwait(false);
+                if (state.CrywolfMap is not { } map) continue;
+
+                await ctx.ForEachPlayerAsync(async player =>
+                {
+                    if (!ReferenceEquals(player.CurrentMap, map)) return;
+                    var classNum = (int)(player.SelectedCharacter?.CharacterClass?.Number ?? 0);
+                    if (!ElfClassNumbers.Contains(classNum)) return;
+
+                    var elfPos = player.Position;
+                    for (int i = 0; i < 5; i++)
+                    {
+                        var altarPos = state.GetAltarPosition(i);
+                        if (altarPos is null) continue;
+                        var dist = Math.Abs((int)elfPos.X - (int)altarPos.Value.X)
+                                 + Math.Abs((int)elfPos.Y - (int)altarPos.Value.Y);
+                        if (dist > ElfActivationRange) continue;
+
+                        var result = state.TryMakeContract(player, i);
+                        if (result == CrywolfGameServerState.ContractResult.Success)
+                        {
+                            await player.ShowBlueMessageAsync(
+                                $"[Crywolf] Â¡Contrato activado! Permanece a {CrywolfGameServerState.ContractBreakRange} tiles del Altar.")
+                                .ConfigureAwait(false);
+                        }
+                    }
+                }).ConfigureAwait(false);
+            }
+            catch (OperationCanceledException) { break; }
+            catch { /* absorb */ }
+        }
+    }

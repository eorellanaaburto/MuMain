+/// <summary>
+/// Balgass boss. Spawns at (118,68) south of the temple and marches through waypoints
+/// into the sanctuary to attack the Wolf Statue, then altars, then players.
+/// </summary>
+public class CrywolfBossIntelligence : BasicMonsterIntelligence
+{
+    // Two waypoints guide Balgass from spawn (118,68) into the temple (Wolf Statue ~121,31).
+    // Each segment ≤16 tiles per axis (ScopedGridNetwork limit).
+    private static readonly Point[] BossWaypoints = [new(118, 55), new(120, 40)];
+
+    private readonly CrywolfGameServerState _state;
+    private int _waypointIndex;
+
+    public CrywolfBossIntelligence(CrywolfGameServerState state)
+    {
+        this._state = state;
+        this.CanWalkOnSafezone = true;
+    }
+
+    public override bool CanWalkOn(Point target)
+        => this.Monster.CurrentMap?.Terrain.AIgrid[target.X, target.Y] != 0;
+
+    protected override async ValueTask<IAttackable?> SearchNextTargetAsync()
+    {
+        // While still navigating, only engage Players — no NPCs.
+        if (this._waypointIndex < BossWaypoints.Length)
+        {
+            var t = await base.SearchNextTargetAsync().ConfigureAwait(false);
+            return t is Player ? t : null;
+        }
+
+        // Inside the temple — Wolf Statue first, then altars, then Players only.
+        var statue = this._state.WolfStatue;
+        if (statue is not null && statue.IsAlive) return statue;
+        var altar = this._state.GetNearestAltar(this.Monster.Position, this.Monster.Definition.ViewRange);
+        if (altar is not null) return altar;
+        var baseTarget = await base.SearchNextTargetAsync().ConfigureAwait(false);
+        return baseTarget is Player ? baseTarget : null;
+    }
+
+    protected override async ValueTask TickWithoutTargetAsync()
+    {
+        if (this._waypointIndex < BossWaypoints.Length)
+        {
+            var target = BossWaypoints[this._waypointIndex];
+            var pos    = this.Monster.Position;
+            var dist   = Math.Abs((int)pos.X - (int)target.X) + Math.Abs((int)pos.Y - (int)target.Y);
+            if (dist <= 3) { this._waypointIndex++; return; }
+            if (!await this.Monster.WalkToAsync(target).ConfigureAwait(false))
+            {
+                var dx   = Math.Sign((int)target.X - (int)pos.X);
+                var dy   = Math.Sign((int)target.Y - (int)pos.Y);
+                var step = new Point((byte)(pos.X + dx), (byte)(pos.Y + dy));
+                if (this.CanWalkOn(step))
+                    await this.Monster.WalkToAsync(step).ConfigureAwait(false);
+                else
+                    await this.Monster.RandomMoveAsync().ConfigureAwait(false);
+            }
+            return;
+        }

-    // For invader spawns outside the sanctuary (safezone already cleared before this runs).
-    private static Point FindNearestWalkableTile(GameMapTerrain terrain, byte cx, byte cy, int radius = 15)
-    {
-        if (terrain.WalkMap[cx, cy] && !terrain.SafezoneMap[cx, cy])
-            return new Point(cx, cy);
-
-        for (int r = 1; r <= radius; r++)
-        {
-            for (int dx = -r; dx <= r; dx++)
-            for (int dy = -r; dy <= r; dy++)
-            {
-                if (Math.Abs(dx) != r && Math.Abs(dy) != r) continue;
-                int nx = cx + dx, ny = cy + dy;
-                if (nx < 0 || nx > 255 || ny < 0 || ny > 255) continue;
-                byte bx = (byte)nx, by = (byte)ny;
-                if (terrain.WalkMap[bx, by] && !terrain.SafezoneMap[bx, by])
-                    return new Point(bx, by);
-            }
-        }
-
-        return new Point(cx, cy);
-    }
-
-    // For altar/statue spawns inside the sanctuary (safezone already cleared; only needs WalkMap=true).
-    private static Point FindNearestWalkableAnywhere(GameMapTerrain terrain, byte cx, byte cy, int radius = 10)
-    {
-        if (terrain.WalkMap[cx, cy]) return new Point(cx, cy);
-
-        for (int r = 1; r <= radius; r++)
-        {
-            for (int dx = -r; dx <= r; dx++)
-            for (int dy = -r; dy <= r; dy++)
-            {
-                if (Math.Abs(dx) != r && Math.Abs(dy) != r) continue;
-                int nx = cx + dx, ny = cy + dy;
-                if (nx < 0 || nx > 255 || ny < 0 || ny > 255) continue;
-                byte bx = (byte)nx, by = (byte)ny;
-                if (terrain.WalkMap[bx, by]) return new Point(bx, by);
-            }
-        }
-
-        return new Point(cx, cy);

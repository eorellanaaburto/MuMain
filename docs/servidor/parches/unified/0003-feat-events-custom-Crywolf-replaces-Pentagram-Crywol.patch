+    private static async ValueTask<Monster?> SpawnInvaderAsync(
+        ushort mobId, byte x, byte y, INpcIntelligence ai,
+        CrywolfGameServerState crywolfState, InvasionGameServerState invasionState,
+        IGameContext ctx, GameMap gameMap, ILogger logger,
+        bool isDarkElf = false, int killPoints = 0)
+    {
+        var def = ctx.Configuration.Monsters.FirstOrDefault(m => m.Number == mobId);
+        if (def is null)
+        {
+            logger.LogError("[Crywolf] Monster #{Id} no encontrado en config.", mobId);
+            return null;
+        }
+
+        var terrain = gameMap.Terrain;
+        // Use WalkMap-only search: outer field (Y>58) is still SafezoneMap=true after the flip,
+        // so FindNearestWalkableTile would relocate all outside spawns into the sanctuary.
+        // FindNearestWalkableAnywhere respects the intended spawn position; CanWalkOnSafezone=true
+        // lets invaders walk out of the outer safezone field toward the sanctuary.
+        var spawnPt = FindNearestWalkableAnywhere(terrain, x, y);
+
+        // HP Ã—3 vs. database base value (double the previous 1.5Ã— event bonus)
+        var hpOverride = (int)(def[Stats.MaximumHealth] * 3.0f);
+
+        var area = new MonsterSpawnArea
+        {
+            GameMap               = gameMap.Definition,
+            MonsterDefinition     = def,
+            SpawnTrigger          = SpawnTrigger.OnceAtEventStart,
+            Quantity              = 1,
+            X1 = spawnPt.X, X2 = spawnPt.X,
+            Y1 = spawnPt.Y, Y2 = spawnPt.Y,
+            MaximumHealthOverride = hpOverride,
+        };
+
+        Monster invader;
+        try
+        {
+            invader = new Monster(area, def, gameMap,
+                ctx.DropGenerator, ai, ctx.PlugInManager, ctx.PathFinderPool);
+            invader.Initialize();
+        }
+        catch (Exception ex)
+        {
+            logger.LogError(ex, "[Crywolf] Error creando Monster #{Id} en ({X},{Y}).", mobId, x, y);
+            return null;
+        }
+
+        if (!invader.IsAlive) return null;
+
+        await gameMap.AddAsync(invader).ConfigureAwait(false);
+        invader.OnSpawn();
+        invader.StartAI();
+        invasionState.AddMonster(invader);
+        crywolfState.TrackInvader(invader, isDarkElf: isDarkElf, killPoints: killPoints);
+
+        // +40% attack damage on all event invaders.
+        var boost = new ConstantElement(AttackMultiplier, AggregateType.Multiplicate);
+        invader.Attributes.AddElement(boost, Stats.MinimumPhysBaseDmg);
+        invader.Attributes.AddElement(new ConstantElement(AttackMultiplier, AggregateType.Multiplicate), Stats.MaximumPhysBaseDmg);
+        invader.Attributes.AddElement(new ConstantElement(AttackMultiplier, AggregateType.Multiplicate), Stats.MinimumWizBaseDmg);
+        invader.Attributes.AddElement(new ConstantElement(AttackMultiplier, AggregateType.Multiplicate), Stats.MaximumWizBaseDmg);
+
+        // Scale Stats.MaximumHealth to match hpOverride so client HP bar shows one full segment.
+        var invaderBaseMaxHp = invader.Attributes[Stats.MaximumHealth];
+        if (invaderBaseMaxHp > 0)
+        {
+            invader.Attributes.AddElement(
+                new ConstantElement((float)hpOverride / (float)invaderBaseMaxHp, AggregateType.Multiplicate),
+                Stats.MaximumHealth);
+        }
+
+        return invader;
+    }

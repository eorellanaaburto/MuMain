-    /// <inheritdoc />
-    protected override async ValueTask SpawnMobsOnMapsAsync(InvasionGameServerState state)
-    {
-        await CheckAndRevertShadowBonusIfExpiredAsync(state.Context).ConfigureAwait(false);
-
-        if (state is not CrywolfGameServerState crywolfState) return;
-
-        if (crywolfState.IsCrywolfRunning)
-        {
-            var ctxLog = state.Context.LoggerFactory.CreateLogger(this.GetType());
-            ctxLog.LogWarning("[Crywolf] Evento ya en ejecuci\ufffdn \u2014 inicio ignorado.");
-            return;
-        }
-
-        Interlocked.Exchange(ref this._onFinishedGuard, 0); // reset guard for new event run
-        crywolfState.IsCrywolfRunning = true;
-        crywolfState.EventStartedAt   = DateTimeOffset.UtcNow;
-        crywolfState.ResetInvasionTracking();
-
-        var ctx    = state.Context;
-        var logger = ctx.LoggerFactory.CreateLogger(this.GetType());
-
-        CrywolfContractRegistry.Register(ctx, crywolfState);
-
-        var gameMap = await ctx.GetMapAsync(InvasionMaps.CrywolfFortress).ConfigureAwait(false);
-        if (gameMap is null)
-        {
-            logger.LogError("[Crywolf] Mapa CrywolfFortress no encontrado \u2014 evento cancelado.");
-            crywolfState.IsCrywolfRunning = false;
-            CrywolfContractRegistry.Unregister(ctx);
-            return;
-        }
-
-        crywolfState.CrywolfMap = gameMap;
-
-        // \u2500\u2500 Phase 1: Flip ENTIRE MAP safezone \u2192 battle zone \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500
-        // All safezone tiles removed so monsters walk and attack freely everywhere.
-        var terrain = gameMap.Terrain;
-        for (int ix = 0; ix <= 255; ix++)
-        for (int iy = 0; iy <= 255; iy++)
-        {
-            byte bx = (byte)ix, by = (byte)iy;
-            if (!terrain.SafezoneMap[bx, by]) continue;
-            terrain.SafezoneMap[bx, by] = false;
-            terrain.UpdateAiGridValue(bx, by);
-            crywolfState.FlippedTiles.Add((bx, by));
-        }
-
-        logger.LogInformation("[Crywolf] Mapa completo: {Count} tiles safezone \u2192 zona de batalla.", crywolfState.FlippedTiles.Count);
-
-        // Notify clients that the entire map is now a combat zone.
-        var (ax1, ay1, ax2, ay2) = SanctuaryArea;
-        await ctx.ForEachPlayerAsync(p =>
-        {
-            if (!ReferenceEquals(p.CurrentMap, gameMap)) return Task.CompletedTask;
-            return p.InvokeViewPlugInAsync<IChangeTerrainAttributesViewPlugin>(v =>
-                v.ChangeAttributesAsync(TerrainAttributeType.Safezone, false, [(ax1, ay1, ax2, ay2)])).AsTask();
-        }).ConfigureAwait(false);
-
-        // \u2500\u2500 Phase 2: Spawn Wolf Statue + Wolf Altars \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500
-        int altarCount = 0;
-        foreach (var (npcNumber, sx, sy) in AltarSpawns)
-        {
-            var def = ctx.Configuration.Monsters.FirstOrDefault(m => m.Number == npcNumber);
-            if (def is null)
-            {
-                logger.LogWarning("[Crywolf] Phase2: NPC #{N} no encontrado \u2014 omitido.", npcNumber);
-                continue;
-            }
-
-            // Use WalkMap-only search: safezone already cleared, statue/altars may sit on terrain walls.
-            var spawnPt   = FindNearestWalkableAnywhere(terrain, sx, sy);
-            int hpOverride = npcNumber == 204 ? StatueMaxHealth : AltarMaxHealth;
-
-            var area = new MonsterSpawnArea
-            {
-                GameMap               = gameMap.Definition,
-                MonsterDefinition     = def,
-                SpawnTrigger          = SpawnTrigger.OnceAtEventStart,
-                Quantity              = 1,
-                X1 = spawnPt.X, X2 = spawnPt.X,
-                Y1 = spawnPt.Y, Y2 = spawnPt.Y,
-                Direction             = Direction.South,
-                MaximumHealthOverride = hpOverride,
-            };
-
-            Monster altar;
-            try
-            {
-                altar = new Monster(area, def, gameMap,
-                    ctx.DropGenerator, new NullMonsterIntelligence(),
-                    ctx.PlugInManager, ctx.PathFinderPool);
-                altar.Initialize();
-            }
-            catch (Exception ex)
-            {
-                logger.LogError(ex, "[Crywolf] Phase2: Error spawneando NPC #{N}.", npcNumber);
-                continue;
-            }
-
-            if (!altar.IsAlive) continue;
-
-            // Scale Stats.MaximumHealth so the client HP bar matches the override HP.
-            var altarBaseMaxHp = altar.Attributes[Stats.MaximumHealth];
-            if (altarBaseMaxHp > 0)
-            {
-                altar.Attributes.AddElement(
-                    new ConstantElement((float)hpOverride / (float)altarBaseMaxHp, AggregateType.Multiplicate),
-                    Stats.MaximumHealth);
-            }
-
-            await gameMap.AddAsync(altar).ConfigureAwait(false);
-            altar.OnSpawn();
-            state.AddMonster(altar);
-
-            if (npcNumber == 204)
-            {
-                // Wolf Statue: all players blocked \u2014 only monster invaders can damage it.
-                altar.AttackBlocker = attacker => attacker is Player;
-                crywolfState.TrackWolfStatue(altar);
-                logger.LogInformation("[Crywolf] Wolf Statue spawneada en ({X},{Y}) HP={H}.", spawnPt.X, spawnPt.Y, StatueMaxHealth);
-            }
-            else if (npcNumber is >= 205 and <= 209)
-            {
-                // Wolf Altars: non-Elf players blocked. Elves pass through for contract activation
-                // (WolfAltarGotHitPlugin restores their damage and creates the contract).
-                altar.AttackBlocker = attacker =>
-                    attacker is Player player
-                    && !ElfClassNumbers.Contains((int)(player.SelectedCharacter?.CharacterClass?.Number ?? 0));
-
-                int idx = npcNumber - 205;
-                crywolfState.TrackAltarMonster(idx, altar);
-                int displayNum = npcNumber - 204;
-                altar.Died += (_, info) =>
-                {
-                    string byPlayer = info.KillerId > 0 ? " (por jugador \u2014 TRAMPA)" : string.Empty;
-                    _ = ctx.SendGlobalNotificationAsync(
-                        $"[Crywolf] \ufffdWolf Altar {displayNum} destruido{byPlayer}! Altares restantes: {crywolfState.AltarsAlive}/5")
-                        .AsTask();

+    private static async ValueTask SpawnBossAsync(
+        CrywolfGameServerState crywolfState, InvasionGameServerState invasionState,
+        IGameContext ctx, GameMap gameMap, ILogger logger)
+    {
+        if (crywolfState.BossSpawned || crywolfState.CrywolfFailed) return;
+
+        var bossDef = ctx.Configuration.Monsters.FirstOrDefault(m => m.Number == 349);
+        if (bossDef is null)
+        {
+            logger.LogError("[Crywolf] DefiniciÃ³n de Balgass (#349) no encontrada â€” boss no aparece.");
+            return;
+        }
+
+        // Balgass aparece en el corredor sur antes del santuario, camina hacia la Wolf Statue.
+        // Evitar (128,29) que overlapa visualmente con la Wolf Statue y bloquea clicks de jugadores.
+        var terrain = gameMap.Terrain;
+        var spawnPt = FindNearestWalkableTile(terrain, 118, 68);
+        if (!terrain.WalkMap[spawnPt.X, spawnPt.Y])
+        {
+            logger.LogError("[Crywolf] Sin tile walkable para Balgass.");
+            return;
+        }
+
+        var area = new MonsterSpawnArea
+        {
+            GameMap               = gameMap.Definition,
+            MonsterDefinition     = bossDef,
+            SpawnTrigger          = SpawnTrigger.OnceAtEventStart,
+            Quantity              = 1,
+            X1 = spawnPt.X, X2 = spawnPt.X,
+            Y1 = spawnPt.Y, Y2 = spawnPt.Y,
+            MaximumHealthOverride = BossMaxHealth,
+        };
+
+        var boss = new Monster(area, bossDef, gameMap,
+            ctx.DropGenerator, new CrywolfBossIntelligence(crywolfState),
+            ctx.PlugInManager, ctx.PathFinderPool);
+
+        boss.Initialize();
+        if (!boss.IsAlive)
+        {
+            logger.LogError("[Crywolf] Balgass no inicializÃ³ correctamente.");
+            return;
+        }
+
+        await gameMap.AddAsync(boss).ConfigureAwait(false);
+        boss.OnSpawn();
+        boss.StartAI();
+        invasionState.AddMonster(boss);
+        crywolfState.BossMonster = boss;
+        crywolfState.SetBossSpawned();
+
+        // Balgass hits 5Ã— harder than a normal invader (invaders already Ã—1.4; boss Ã—7 total vs base).
+        const float BossAttackMult = 5.0f;
+        boss.Attributes.AddElement(new ConstantElement(BossAttackMult, AggregateType.Multiplicate), Stats.MinimumPhysBaseDmg);
+        boss.Attributes.AddElement(new ConstantElement(BossAttackMult, AggregateType.Multiplicate), Stats.MaximumPhysBaseDmg);
+        boss.Attributes.AddElement(new ConstantElement(BossAttackMult, AggregateType.Multiplicate), Stats.MinimumWizBaseDmg);
+        boss.Attributes.AddElement(new ConstantElement(BossAttackMult, AggregateType.Multiplicate), Stats.MaximumWizBaseDmg);
+
+        // Scale Stats.MaximumHealth to match MaximumHealthOverride so the client HP bar
+        // covers the full 70M in one segment instead of cycling multiple complete bars.
+        var bossBaseMaxHp = boss.Attributes[Stats.MaximumHealth];
+        if (bossBaseMaxHp > 0)
+        {
+            boss.Attributes.AddElement(
+                new ConstantElement((float)BossMaxHealth / (float)bossBaseMaxHp, AggregateType.Multiplicate),
+                Stats.MaximumHealth);
+        }
+
+        // Visual aura: Berserker (81) = red aggressive glow, Requiem (74) = dark death aura.
+        // No stat powerups â€” purely visual; duration covers the full event window.
+        foreach (var effectNum in new short[] { 81, 74 })
+        {
+            var effectDef = ctx.Configuration.MagicEffects.FirstOrDefault(e => e.Number == effectNum && e.InformObservers);
+            if (effectDef is not null)
+            {
+                var aura = new MagicEffect(TimeSpan.FromMinutes(10), effectDef);
+                await boss.MagicEffectList.AddEffectAsync(aura).ConfigureAwait(false);
+            }
+        }
+
+        boss.Died += (_, info) =>
+        {
+            crywolfState.SetBossKilled();
+            if (info.KillerId > 0)
+                crywolfState.AddKillPoints(info.KillerName, PtBoss);
+            _ = ctx.SendGlobalNotificationAsync("[Crywolf] Â¡BALGASS fue derrotado! Â¡La defensa resistiÃ³!").AsTask();
+        };
+
+        await ctx.SendGlobalNotificationAsync(
+            "[Crywolf] â˜… OLEADA 7/7 â€” Â¡Â¡BALGASS ha aparecido y marcha hacia la Wolf Statue!! Â¡Quedan 3 minutos! â˜…")
+            .ConfigureAwait(false);
+        logger.LogInformation("[Crywolf] BALGASS apareciÃ³ en altar zone ({X},{Y}) HP={H}.", spawnPt.X, spawnPt.Y, BossMaxHealth);
+    }

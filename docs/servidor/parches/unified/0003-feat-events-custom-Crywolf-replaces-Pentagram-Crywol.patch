-        var cts = new CancellationTokenSource();
-        crywolfState.EventCts = cts;
-
-        _ = Task.Run(() => MonitorContractsAsync(crywolfState, cts.Token), cts.Token);
-        _ = Task.Run(() => AltarHpBroadcastAsync(crywolfState, ctx, cts.Token), cts.Token);
-        _ = Task.Run(() => ContractElfSnapBackAsync(crywolfState, cts.Token), cts.Token);
-        _ = Task.Run(() => PrepPhaseElfProximityAsync(crywolfState, ctx, cts.Token), cts.Token);
-        _ = Task.Run(() => WaveSchedulerAsync(crywolfState, state, ctx, gameMap, logger, cts.Token), cts.Token);
-
-        // Boss-killed watcher: ends event when Balgass dies.
-        // Uses absolute deadline (T+30min) \u2014 NOT IsCrywolfRunning \u2014 so the base class
-        // timer firing at TaskDuration does NOT cut the loop before the boss is killed.
-        _ = Task.Run(async () =>
-        {
-            try
-            {
-                var deadline = crywolfState.EventStartedAt + TimeSpan.FromMinutes(30);
-                while (!crywolfState.BossKilled && !crywolfState.CrywolfFailed
-                       && DateTimeOffset.UtcNow < deadline)
-                    await Task.Delay(500).ConfigureAwait(false);
-
-                if (crywolfState.BossKilled)
-                {
-                    await Task.Delay(3000).ConfigureAwait(false); // 3s victory pause
-                    if (!cts.IsCancellationRequested)
-                        await cts.CancelAsync().ConfigureAwait(false);
-                    await this.OnFinishedAsync(state).ConfigureAwait(false);
-                }
-                else if (!crywolfState.CrywolfFailed)
-                {
-                    // Absolute deadline reached with boss alive \u2014 end as defeat.
-                    crywolfState.CrywolfFailed = true;
-                    if (!cts.IsCancellationRequested)
-                        await cts.CancelAsync().ConfigureAwait(false);
-                    await this.OnFinishedAsync(state).ConfigureAwait(false);
-                }
-                // CrywolfFailed=true \u2192 defeat watcher already handles OnFinishedAsync.
-            }
-            catch (Exception ex) { logger.LogError(ex, "[Crywolf] Error en boss-killed watcher."); }
-        }, CancellationToken.None);
-
-        // Defeat watcher: ends event immediately when altars/statue are destroyed.
-        _ = Task.Run(async () =>
-        {
-            try
-            {
-                while (!crywolfState.CrywolfFailed && crywolfState.IsCrywolfRunning)
-                    await Task.Delay(500).ConfigureAwait(false);
-                if (crywolfState.CrywolfFailed)
-                {
-                    await Task.Delay(2000).ConfigureAwait(false); // 2s dramatic pause
-                    if (!crywolfState.BossKilled) // boss-killed watcher takes precedence for victory
-                    {
-                        if (!cts.IsCancellationRequested)
-                            await cts.CancelAsync().ConfigureAwait(false);
-                        await this.OnFinishedAsync(state).ConfigureAwait(false);
-                    }
-                }
-            }
-            catch (Exception ex) { logger.LogError(ex, "[Crywolf] Error en defeat watcher."); }
-        }, CancellationToken.None);
-
-        crywolfState.SetArmySpawnSucceeded(true);
-
-        await ctx.SendGlobalNotificationAsync(
-            "[Crywolf] \ufffdPreparaci\ufffdn Crywolf! Elfas: tienen 5 MINUTOS para pararse junto a un Wolf Altar (rango 5 tiles) y activarlo.")

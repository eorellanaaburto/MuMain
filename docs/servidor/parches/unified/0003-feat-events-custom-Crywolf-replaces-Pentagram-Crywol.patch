+/// <summary>Which of the three Crywolf entry corridors this invader uses.</summary>
+public enum CrywolfEntry { West, South, East }
+
+/// <summary>
+/// Two-corridor sanctuary layout (verified via Terrain34.att):
+///   LEFT  corridor X=88-118: accessible from West/South entries.
+///             → Left-passage altars at X=102-105, Y=35-38 (Altars 3 and 4).
+///   RIGHT corridor X=140-160: accessible from East entry.
+///             → Main altar zone X=122-133 Y=27-33 via east path (Wolf Statue + Altars 1,2,5).
+///   The two corridors meet ONLY at Y=27 (X=122-150 fully walkable).
+///
+/// ScopedGridNetwork max segment = 16 tiles per axis — every waypoint step must be ≤16 in X AND Y.
+/// Advance threshold = 3 tiles (Manhattan). Worst-case positions per corridor:
+/// West spawns:  X=83-93,  Y=60-76 → advance from WP0 at ~(88,67), next ΔY=15 ✓
+/// South spawns: X=108-128,Y=72-90 → advance from WP0 at ~(121,78), next ΔX=6,ΔY=13 ✓
+/// East spawns:  X=160-173,Y=43-55 → advance from WP0 at ~(164,53), next ΔX=11,ΔY=7 ✓
+/// </summary>
+public class CrywolfMeleeIntelligence : BasicMonsterIntelligence
+{
+    // West: advance threshold=3. Each segment ≤16 per axis from worst-case advance position.
+    private static readonly Point[] WestWaypoints  = [new(88, 64), new(88, 52), new(91, 44), new(103, 37)];
+    // South: advance threshold=3. Each segment ≤16 per axis from worst-case advance position.
+    private static readonly Point[] SouthWaypoints = [new(118, 78), new(115, 65), new(112, 54), new(107, 43), new(103, 37)];
+    // East: existing waypoints already satisfy ≤16 per axis with threshold=3.
+    private static readonly Point[] EastWaypoints  = [new(161, 50), new(153, 46), new(148, 38), new(135, 27)];
+
+    private readonly CrywolfGameServerState _state;
+    private readonly Point[] _waypoints;
+    private int _waypointIndex;
+
+    public CrywolfMeleeIntelligence(CrywolfGameServerState state, CrywolfEntry entry = CrywolfEntry.West)
+    {
+        this._state = state;
+        this._waypoints = entry switch
+        {
+            CrywolfEntry.South => SouthWaypoints,
+            CrywolfEntry.East  => EastWaypoints,
+            _                  => WestWaypoints,
+        };
+        this.CanWalkOnSafezone = true;
+    }
+
+    public override bool CanWalkOn(Point target)
+    {
+        // Allow movement on safezone tiles (AIgrid=129) — outer field is always safezone.
+        return this.Monster.CurrentMap?.Terrain.AIgrid[target.X, target.Y] != 0;
+    }
+
+    protected override async ValueTask<IAttackable?> SearchNextTargetAsync()
+    {
+        // Only target Players from base — prevents attacking guards/NPCs.
+        var baseTarget = await base.SearchNextTargetAsync().ConfigureAwait(false);
+        if (baseTarget is Player) return baseTarget;
+        // Only return altar once inside the sanctuary (waypoints done).
+        if (this._waypointIndex >= this._waypoints.Length)
+            return this._state.GetNearestAltar(this.Monster.Position, 255);
+        return null;
+    }
+
+    protected override async ValueTask TickWithoutTargetAsync()
+    {
+        if (this.Monster.Attributes[Stats.IsFrozen] > 0) return;
+
+        if (this._waypointIndex < this._waypoints.Length)
+        {
+            var target = this._waypoints[this._waypointIndex];
+            var pos    = this.Monster.Position;
+            var dist   = Math.Abs((int)pos.X - (int)target.X) + Math.Abs((int)pos.Y - (int)target.Y);
+            if (dist <= 3) { this._waypointIndex++; return; }
+            if (!await this.Monster.WalkToAsync(target).ConfigureAwait(false))
+            {
+                // Pathfinder failed — step one tile toward waypoint to avoid getting stuck.
+                var dx = Math.Sign((int)target.X - (int)pos.X);
+                var dy = Math.Sign((int)target.Y - (int)pos.Y);
+                var step = new Point((byte)(pos.X + dx), (byte)(pos.Y + dy));
+                if (this.CanWalkOn(step))
+                    await this.Monster.WalkToAsync(step).ConfigureAwait(false);
+                else
+                    await this.Monster.RandomMoveAsync().ConfigureAwait(false);
+            }
+            return;
+        }
+
+        // Inside altar zone — march toward nearest altar; never idle.
+        var nearestAltar = this._state.GetNearestAltar(this.Monster.Position, 255);
+        if (nearestAltar is not null)
+        {
+            if (!await this.Monster.WalkToAsync(nearestAltar.Position).ConfigureAwait(false))
+                await this.Monster.RandomMoveAsync().ConfigureAwait(false);
+            return;
+        }
+
+        await this.Monster.RandomMoveAsync().ConfigureAwait(false);
+    }
+}

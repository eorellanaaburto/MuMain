-    private static async ValueTask GiveExcellentItemAsync(Player player, IGameContext ctx)
-    {
-        var charClass = player.SelectedCharacter?.CharacterClass;
-        if (charClass is null) return;
-
-        // Groups 0-5: weapons. Groups 6-11: armor (helm/armor/pants/gloves/boots/shield).
-        // Excludes ammunition and items without excellent options.
-        var eligible = ctx.Configuration.Items
-            .Where(i => i.Group <= 11
-                        && !i.IsAmmunition
-                        && i.DropLevel >= 130
-                        && i.QualifiedCharacters.Contains(charClass)
-                        && i.PossibleItemOptions.Any(o =>
-                               o.PossibleOptions.Any(p => p.OptionType == ItemOptionTypes.Excellent)))
-            .ToList();
-
-        if (eligible.Count == 0) return;
-
-        var itemDef   = eligible[Random.Shared.Next(eligible.Count)];
-        byte itemLevel = (byte)Math.Min(15, (int)itemDef.MaximumItemLevel);
-
-        var item = new TemporaryItem
-        {
-            Definition = itemDef,
-            Level      = itemLevel,
-            HasSkill   = itemDef.Skill is not null,
-            Durability = itemDef.Durability,
-        };
-
-        // All excellent options

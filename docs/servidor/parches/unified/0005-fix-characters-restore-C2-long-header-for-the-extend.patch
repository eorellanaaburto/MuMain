From 7aa4d8cc459ef45ec52418498d2bad684fbd973a Mon Sep 17 00:00:00 2001
From: openmu-sync <openmu-sync@local>
Date: Mon, 12 Oct 2026 23:26:17 +0000
Subject: [PATCH 5/6] fix(characters): restore C2 long header for the extended
 character list (6 characters exceed 255 bytes)

---
 .../ShowCharacterListExtendedPlugIn.cs        | 35 +++++++++++++++----
 1 file changed, 28 insertions(+), 7 deletions(-)

diff --git a/GameServer/RemoteView/Character/ShowCharacterListExtendedPlugIn.cs b/GameServer/RemoteView/Character/ShowCharacterListExtendedPlugIn.cs
index 77a3733..c8e59a3 100644
--- a/GameServer/RemoteView/Character/ShowCharacterListExtendedPlugIn.cs
+++ b/GameServer/RemoteView/Character/ShowCharacterListExtendedPlugIn.cs
@@ -1,4 +1,4 @@
-﻿// <copyright file="ShowCharacterListExtendedPlugIn.cs" company="MUnique">
+// <copyright file="ShowCharacterListExtendedPlugIn.cs" company="MUnique">
 // Licensed under the MIT License. See LICENSE file in the project root for full license information.
 // </copyright>
 
@@ -11,6 +11,7 @@ using MUnique.OpenMU.GameLogic.Views.Character;
 using MUnique.OpenMU.GameServer.RemoteView.Guild;
 using MUnique.OpenMU.Interfaces;
 using MUnique.OpenMU.Network;
+using MUnique.OpenMU.Network.Packets;
 using MUnique.OpenMU.Network.Packets.ServerToClient;
 using MUnique.OpenMU.Network.PlugIns;
 using MUnique.OpenMU.PlugIns;
@@ -71,14 +72,34 @@ public class ShowCharacterListExtendedPlugIn : IShowCharacterListPlugIn
         var appearanceSerializer = this._player.AppearanceSerializer;
         int Write()
         {
-            var size = CharacterListExtendedRef.GetRequiredSize(account.Characters.Count);
+            var shortPacketSize = CharacterListExtendedRef.GetRequiredSize(account.Characters.Count);
+            var useLongHeader = shortPacketSize > byte.MaxValue;
+            var size = shortPacketSize + (useLongHeader ? 1 : 0);
             var span = connection.Output.GetSpan(size)[..size];
-            var packet = new CharacterListExtendedRef(span)
+
+            CharacterListExtendedRef packet;
+            if (useLongHeader)
+            {
+                var header = new C2HeaderWithSubCodeRef(span)
+                {
+                    Type = 0xC2,
+                    Length = checked((ushort)size),
+                    Code = CharacterListExtendedRef.Code,
+                    SubCode = CharacterListExtendedRef.SubCode,
+                };
+
+                // C2 header is one byte longer than C1. View rest as legacy packet
+                // so generated field offsets remain unchanged after the header.
+                packet = span[1..];
+            }
+            else
             {
-                UnlockFlags = unlockFlags,
-                CharacterCount = (byte)account.Characters.Count,
-                IsVaultExtended = account.IsVaultExtended,
-            };
+                packet = new CharacterListExtendedRef(span);
+            }
+
+            packet.UnlockFlags = unlockFlags;
+            packet.CharacterCount = (byte)account.Characters.Count;
+            packet.IsVaultExtended = account.IsVaultExtended;
 
             var j = 0;
             foreach (var character in account.Characters.OrderBy(c => c.CharacterSlot))
-- 
